{
  "name": "dsh-thinking-intensity",
  "version": "0.2.0",
  "description": "A dot-matrix pill above the composer that reads and writes the session's real reasoning effort, with a particle field that grows and stretches into scan lines as the effort climbs.",
  "license": "MIT",
  "author": "BenedictTom",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "reasoning-effort",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenedictTom/dsh-thinking-intensity.git"
  },
  "homepage": "https://github.com/BenedictTom/dsh-thinking-intensity#readme",
  "bugs": {
    "url": "https://github.com/BenedictTom/dsh-thinking-intensity/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}