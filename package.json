{
  "name": "dsh-thinking-pill",
  "version": "1.0.1",
  "description": "Thinking-intensity pill for DeepSeek Harness: dot-matrix effort label and a particle field that turns into horizontal light streaks as reasoning effort rises.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reasoning-effort",
    "thinking",
    "model-selector",
    "slider",
    "ui",
    "cordis"
  ],
  "author": "BenedictTom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenedictTom/dsh-thinking-intensity.git"
  },
  "homepage": "https://github.com/BenedictTom/dsh-thinking-intensity#readme",
  "bugs": {
    "url": "https://github.com/BenedictTom/dsh-thinking-intensity/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/host.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check lib/host.js && node --check lib/client/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
